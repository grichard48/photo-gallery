# Copy this file to ".env" and fill in your Cloudflare R2 credentials.
# The .env file is gitignored — never commit your real keys.
#
# Find these in the Cloudflare dashboard:
#   Account ID:            R2 Overview page (right-hand sidebar)
#   Access Key / Secret:   R2 > Manage R2 API Tokens > Create API Token
#                          (give it "Object Read & Write" on your bucket)

R2_ACCOUNT_ID=your_account_id_here
R2_ACCESS_KEY_ID=your_access_key_id_here
R2_SECRET_ACCESS_KEY=your_secret_access_key_here
R2_BUCKET=photo-gallery
